# 改写兜底巡检 / 飞书告警 所需环境变量清单（无密钥，可提交）
#
# 部署时：复制本文件为 scripts/.env 或系统路径（如 /opt/aigc-humanizer/feishu.env），
# 填入真实值后 chmod 600，切勿提交真实值。cron 通过 `set -a; . <该文件>` 注入。

# ── 飞书自建应用凭证（feishu_alert.py 使用）──
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ALERT_OPEN_ID=ou_xxxxxxxx

# ── 线上 SQLite 库路径（check_fallback_orders.py 使用）──
HUMANIZER_DB_PATH=/opt/aigc-humanizer-en/instance/aigc_humanizer.db
